{
    "name": "student/rezerwownik",
    "description": "Rezerwownik — system rezerwacji sal do nauki, Projekt W4",
    "type": "project",
    "authors": [
        {"name": "Kamil Marczak"},
        {"name": "Konrad Guzek"}
    ],
    "require": {
        "php": ">=8.1",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/",
            "App\\Controllers\\": "controllers/"
        }
    },
    "scripts": {
        "dev":     "@php -S localhost:8000 router.php",
        "fmt":     "@php vendor/bin/php-cs-fixer fix --dry-run --diff",
        "fmt:fix": "@php vendor/bin/php-cs-fixer fix"
    },
    "config": {
        "optimize-autoloader": true
    }
}
